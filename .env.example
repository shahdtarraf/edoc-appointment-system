# Local / XAMPP defaults. Do not commit a filled .env.
# Demo Docker uses docker-compose.demo.yml (SQL_Database_edoc_demo on 3308).
# Render: use the dashboard and .env.render.example (names only).

# --- local PHP without Docker ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SQL_Database_edoc
DB_USER=root
DB_PASSWORD=
DB_SSL=

