# Render dashboard placeholders. Copy values in the dashboard only.
# Do not put real secrets in Git. Do not use Demo accounts in production.

# --- edoc-web-staging ---
# PORT is set by Render (example 10000)
# DB_HOST=
# DB_PORT=3306
# DB_NAME=          # Staging database name. Never SQL_Database_edoc_demo on a hosted host.
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true
# SESSION_COOKIE_SECURE=1
# AI_SERVICE_URL=https://edoc-specialty-staging.onrender.com
# AI_SERVICE_TIMEOUT=6
# AI_SERVICE_TOKEN=
# ASSISTANT_URL=https://edoc-assistant-staging.onrender.com
# ASSISTANT_TOKEN=
# Do not set NOSHOW_URL or NOSHOW_TOKEN on this service.

# --- edoc-specialty-staging ---
# PORT=10000
# AI_SERVICE_TOKEN=   # same value as AI_SERVICE_TOKEN on the web service

# --- edoc-assistant-staging ---
# PORT=10000
# ASSISTANT_SERVICE_TOKEN=   # same value as ASSISTANT_TOKEN on the web service
